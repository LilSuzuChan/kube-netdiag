{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnostic Report v0alpha1",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "findings",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "v0alpha1"
    },
    "tool": {
      "const": "kube-netdiag"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "classification",
          "summary",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "classification": {
            "enum": [
              "confirmed",
              "predicted",
              "unknown"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "resource",
                "field"
              ],
              "properties": {
                "resource": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
